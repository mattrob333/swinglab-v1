# SwingLab 2026 environment variables.
#
# Leave both NEXT_PUBLIC_* values unset to run in LOCAL-ONLY mode (no sign-in,
# no sync; everything stays in the browser's IndexedDB). That is how
# development and the Playwright tests run.
#
# On Vercel these are injected automatically by the Supabase integration
# (Vercel dashboard -> Storage -> Supabase). See docs/DEPLOY.md.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co  (local stack: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. Either the new publishable key (sb_publishable_...) ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ... or the legacy anon key (JWT). Only one of the two is needed.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never expose these to the browser; the app does not need them at runtime.
# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY are only for admin scripts.
